# bootlab-esp — pinned dependency versions
# Source of truth for BL-002 (toolchains) and all builds.
# Latest STABLE releases at start (2026-09-15). Official sources only.

# --- Python / host tooling ---
PYTHON=3.13
PIP=pip-25.x
ESPTOOL=5.4.0              # installed in .venv (verified: esptool.py version)
CRYPTOGRAPHY=50.0

# --- C / build toolchain (RPi4, arm64) ---
GCC=14.2.0                 # Debian 14.2.0-19 (host build compiler)
CMAKE=3.31
NINJA=1.12
DTC=1.7.2
GIT=2.47.3

# --- Zephyr ---
ZEPHYR_VERSION=v4.1.0            # LTS/mainline stable (west pin)
ZEPHYR_SDK_VERSION=0.17.0
WEST=1.5.0

# --- ESP-IDF (board #2) ---
ESP_IDF_VERSION=v5.5.0           # latest stable release branch
ESPTOOL_PY=5.4.0

# --- MCUboot (board #1 bootloader) ---
MCUBOOT_VERSION=v2.2.0

# --- esp-iot-solution ble_ota (IDF OTA over BLE) ---
ESP_IOT_SOLUTION_VERSION=v2.0.0

# --- Signing / image tools ---
IMGTOOL_VERSION=2.4.0
