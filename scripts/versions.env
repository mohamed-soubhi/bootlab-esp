# bootlab-esp — pinned dependency versions
# Source of truth for BL-002 (toolchains) and all builds.
# Verified 2026-09-16 from official GitHub release tags (see URLs below).

# --- Python / host tooling ---
PYTHON=3.12.3              # WSL2 host — 3.13 unavailable, functionally equivalent for
                            # esptool/imgtool/west tooling; changed 2026-09-20 during
                            # RPi4->WSL2 migration, see docs/AUDIT_LOG.md
ESPTOOL=5.4.0              # installed in .venv (verified: esptool version -> "esptool v5.4.0")
CRYPTOGRAPHY=50.0          # verified: pip installed cryptography-50.0.1 (matches 50.0.x)

# --- C / build toolchain (RPi4, arm64) ---
GCC=14.2.0                 # Debian 14.2.0-19 (host build compiler)
CMAKE=3.31
NINJA=1.12
DTC=1.7.2
GIT=2.47.3

# --- Zephyr (board #1) ---
# Verified: https://github.com/zephyrproject-rtos/zephyr/releases/tag/v4.4.2
ZEPHYR_VERSION=v4.4.2            # latest stable 4.4.x (4.4.1 is not the latest)
# Verified: https://github.com/zephyrproject-rtos/sdk-ng/releases/tag/v1.0.1
ZEPHYR_SDK_VERSION=1.0.1
WEST=1.5.0

# --- ESP-IDF (board #2) ---
# Verified: https://github.com/espressif/esp-idf/releases/tag/v6.0.3
ESP_IDF_VERSION=v6.0.3            # latest stable v6.0.x
ESPTOOL_PY=5.4.0


# --- esp-iot-solution ble_ota (IDF OTA over BLE) ---
# PENDING: component-registry version that declares ESP-IDF 6.0 support.
# If none exists -> ESCALATE per owner instruction.

# --- Signing / image tools ---
IMGTOOL_VERSION=2.4.0
